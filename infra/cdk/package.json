    "@oripa-now/config": "workspace:*",
    "@types/node": "^22.15.3",
    "aws-cdk": "^2.200.1",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
